dec mut a: i32 = !1;

if wa.span == 2 {
	dec mut t = -13;
}

pub const A: u32 = a?.or()? + -2;

pub(module) type AllocVec<
	T: Debug + Format + Clone,
	A: Allocator = Global,
> = Vec<T, A>;

pub struct Span<T: Clone + Index + IndexMut> {
	pub start: usize,
	pub len: usize,
	pub file_id: T,
}

pub enum Trailing {
	Allowed = 303,
	Forbidden = 404,
}

union Result<T, E: Error> {
	Ok(T),
	Err(E),
}

union Option<T> {
	Some(T),
	None,
}
